{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash(git: *)"
    ],
    "defaultMode": "dontAsk"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.prefect.cloud",
        "oauth2.googleapis.com",
        "us-east5-aiplatform.googleapis.com",
        "downloads.claude.ai",
        "api.anthropic.com"
      ],
      "allowAllUnixSockets": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv/",
        "~/.ssh/sockets/"
      ],    
      "allowRead": [
        "~/.claude/",
        "/usr/bin",
        "/usr/local/bin",
        "/opt/homebrew/bin"
      ]
    },
    "enableWeakerNetworkIsolation": true
  }
}
